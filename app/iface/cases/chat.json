      "routes": [
        {
          "id": "94609197",
          "key": "custom",
          "name": "发送消息",
          "method": "POST",
          "path": "/messages",
          "auth": true,
          "summary": "发送一条消息，自动建会话",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $c = QUERY SELECT id FROM {{t:conv}} WHERE (owner_only_id = {{user.onlyId}} AND peer_only_id = {{body.to}}) OR (owner_only_id = {{body.to}} AND peer_only_id = {{user.onlyId}}) LIMIT 1;\nLET $cid = 0;\nIF LEN($c.rows) > 0\n  SET $cid = $c.rows[0].id;\nELSE\n  LET $ins = EXEC INSERT INTO {{t:conv}} (owner_only_id, peer_only_id, last_message) VALUES ({{user.onlyId}}, {{body.to}}, {{body.body}});\n  SET $cid = $ins.insertId;\nEND\nEXEC INSERT INTO {{t:msg}} (conv_id, from_only_id, to_only_id, body, msg_type) VALUES ({{vars.cid}}, {{user.onlyId}}, {{body.to}}, {{body.body}}, {{body.msg_type}});\nEXEC UPDATE {{t:conv}} SET last_message = {{body.body}}, updated_at = NOW() WHERE id = {{vars.cid}};\nRETURN 201 { \"ok\": true, \"convId\": $cid };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "发送一条消息，自动建会话",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "16683654",
          "key": "custom",
          "name": "收件箱",
          "method": "GET",
          "path": "/messages",
          "auth": true,
          "summary": "收到的消息",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT id, conv_id, from_only_id, body, read_flag, created_at FROM {{t:msg}} WHERE to_only_id = {{user.onlyId}} ORDER BY id DESC LIMIT 50;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "收到的消息",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "fddbd0e7",
          "key": "custom",
          "name": "标记已读",
          "method": "PUT",
          "path": "/messages/:id/read",
          "auth": true,
          "summary": "已读回执",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:msg}} SET read_flag = 1 WHERE id = {{id}} AND to_only_id = {{user.onlyId}};\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "已读回执",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "d16e8a3f",
          "key": "custom",
          "name": "未读数",
          "method": "GET",
          "path": "/unread",
          "auth": true,
          "summary": "未读消息数",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $r = QUERY SELECT COUNT(*) AS n FROM {{t:msg}} WHERE to_only_id = {{user.onlyId}} AND read_flag = 0;\nRETURN 200 { \"unread\": $r.rows[0].n };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "未读消息数",

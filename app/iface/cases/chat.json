        },
        {
          "id": "6116764f",
          "key": "custom",
          "name": "会话列表",
          "method": "GET",
          "path": "/conversations",
          "auth": true,
          "summary": "我的会话列表",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT c.id, c.last_message, c.updated_at, u.display_name AS peer_name FROM {{t:conv}} c LEFT JOIN {{t:users}} u ON u.only_id = IF(c.owner_only_id = {{user.onlyId}}, c.peer_only_id, c.owner_only_id) WHERE c.owner_only_id = {{user.onlyId}} OR c.peer_only_id = {{user.onlyId}} ORDER BY c.updated_at DESC;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "我的会话列表",
            "description": "",
            "requestExample": "",

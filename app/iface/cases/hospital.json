        {
          "id": "45997220",
          "key": "custom",
          "name": "挂号",
          "method": "POST",
          "path": "/appointments",
          "auth": true,
          "summary": "挂号，防满号",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $s = QUERY SELECT capacity, booked FROM {{t:slot}} WHERE id = {{body.slot_id}} LIMIT 1;\nIF LEN($s.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_SLOT\" };\nEND\nIF $s.rows[0].booked >= $s.rows[0].capacity\n  RETURN 409 { \"ok\": false, \"error\": \"FULL\" };\nEND\nEXEC INSERT INTO {{t:main}} (slot_id, patient_only_id) VALUES ({{body.slot_id}}, {{user.onlyId}});\nEXEC UPDATE {{t:slot}} SET booked = booked + 1 WHERE id = {{body.slot_id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "挂号，防满号",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },

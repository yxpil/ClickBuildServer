      "routes": [
        {
          "id": "b2d2c913",
          "key": "custom",
          "name": "购票",
          "method": "POST",
          "path": "/orders",
          "auth": true,
          "summary": "购票扣库存并出票",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $e = QUERY SELECT price, stock FROM {{t:event}} WHERE id = {{body.event_id}} LIMIT 1;\nIF LEN($e.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_EVENT\" };\nEND\nIF $e.rows[0].stock < {{body.qty}}\n  RETURN 409 { \"ok\": false, \"error\": \"SOLD_OUT\" };\nEND\nLET $ins = EXEC INSERT INTO {{t:main}} (event_id, user_only_id, qty, total) VALUES ({{body.event_id}}, {{user.onlyId}}, {{body.qty}}, {{vars.e.rows.0.price}} * {{body.qty}});\nEXEC UPDATE {{t:event}} SET stock = stock - {{body.qty}} WHERE id = {{body.event_id}};\nEXEC INSERT INTO {{t:ticket}} (order_id, code) VALUES ($ins.insertId, {{onlyId}});\nRETURN 201 { \"ok\": true, \"orderId\": $ins.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "购票扣库存并出票",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "c7602f22",
          "key": "custom",
          "name": "我的票",
          "method": "GET",
          "path": "/my-tickets",
          "auth": true,
          "summary": "我的电子票",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT t.code, t.checked, o.qty, e.title, e.start_at FROM {{t:ticket}} t JOIN {{t:main}} o ON o.id = t.order_id JOIN {{t:event}} e ON e.id = o.event_id WHERE o.user_only_id = {{user.onlyId}};\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "我的电子票",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },

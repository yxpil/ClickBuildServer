            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $ins = EXEC INSERT INTO {{t:main}} (tracking_no, sender, receiver) VALUES ({{body.tracking_no}}, {{body.sender}}, {{body.receiver}});\nEXEC INSERT INTO {{t:track}} (shipment_id, node, detail) VALUES ($ins.insertId, '已揽收', {{body.detail}});\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60

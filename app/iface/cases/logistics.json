          "id": "3b1ddd76",
          "key": "custom",
          "name": "创建运单",
          "method": "POST",
          "path": "/shipments",
          "auth": true,
          "summary": "创建运单并写首个节点",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60

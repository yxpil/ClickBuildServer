            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC INSERT INTO {{t:track}} (shipment_id, node, detail) VALUES ({{id}}, {{body.node}}, {{body.detail}});\nEXEC UPDATE {{t:main}} SET status = {{body.node}} WHERE id = {{id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,

        {
          "id": "06e14957",
          "key": "custom",
          "name": "轨迹查询",
          "method": "GET",
          "path": "/shipments/:no",
          "auth": false,
          "summary": "按运单号联查轨迹",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $s = QUERY SELECT * FROM {{t:main}} WHERE tracking_no = {{path.no}} LIMIT 1;\nLET $t = QUERY SELECT node, detail, created_at FROM {{t:track}} WHERE shipment_id = (SELECT id FROM {{t:main}} WHERE tracking_no = {{path.no}}) ORDER BY id;\nRETURN 200 { \"shipment\": $s.rows, \"tracks\": $t.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "按运单号联查轨迹",
            "description": "",
            "requestExample": "",

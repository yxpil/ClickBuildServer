        {
          "id": "90463d1b",
          "key": "custom",
          "name": "提交报名",
          "method": "POST",
          "path": "/events/:id/signups",
          "auth": false,
          "summary": "校验名额与重复手机号后报名",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $e = QUERY SELECT id, status, capacity, registered_count FROM {{t:main}} WHERE id = {{id}} FOR UPDATE;\nIF LEN($e.rows) == 0\n  RETURN 404 { \"error\": \"NOT_FOUND\", \"message\": \"活动不存在\" };\nEND\nIF $e.rows[0].status != 1\n  RETURN 409 { \"error\": \"EVENT_CLOSED\", \"message\": \"活动已结束，无法报名\" };\nEND\nIF $e.rows[0].capacity > 0 && $e.rows[0].registered_count >= $e.rows[0].capacity\n  RETURN 409 { \"error\": \"EVENT_FULL\", \"message\": \"名额已满\" };\nEND\nLET $d = QUERY SELECT id FROM {{t:reg}} WHERE event_id = {{id}} AND phone = {{body.phone}} LIMIT 1;\nIF LEN($d.rows) > 0\n  RETURN 409 { \"error\": \"DUPLICATE_PHONE\", \"message\": \"这个手机号已经报名过了\" };\nEND\nEXEC INSERT INTO {{t:reg}} (event_id, name, phone, remark, created_at) VALUES ({{id}}, {{body.name}}, {{body.phone}}, {{body.remark}}, NOW());\nEXEC UPDATE {{t:main}} SET registered_count = registered_count + 1, updated_at = NOW() WHERE id = {{id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "校验名额与重复手机号后报名",

        {
          "id": "770cf316",
          "key": "custom",
          "name": "上报遥测",
          "method": "POST",
          "path": "/telemetry",
          "auth": false,
          "summary": "设备密钥校验后上报",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $d = QUERY SELECT id, secret_hash FROM {{t:main}} WHERE device_no = {{body.device_no}} LIMIT 1;\nIF LEN($d.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_DEVICE\" };\nEND\nIF SM4_DEC($d.rows[0].secret_hash, 'clickbuild-key') != {{body.secret}}\n  RETURN 401 { \"ok\": false, \"error\": \"BAD_SECRET\" };\nEND\nEXEC INSERT INTO {{t:tel}} (device_id, temp, humidity, payload) VALUES ({{vars.d.rows.0.id}}, {{body.temp}}, {{body.humidity}}, {{body.payload}});\nEXEC UPDATE {{t:main}} SET last_seen = NOW() WHERE id = {{vars.d.rows.0.id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "设备密钥校验后上报",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },

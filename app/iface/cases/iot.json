        {
          "id": "5ad2728e",
          "key": "custom",
          "name": "温度告警",
          "method": "GET",
          "path": "/alerts",
          "auth": false,
          "summary": "按温度阈值筛选告警",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT d.name, t.temp, t.created_at FROM {{t:tel}} t JOIN {{t:main}} d ON d.id = t.device_id WHERE t.temp > {{query.temp}} ORDER BY t.id DESC LIMIT 100;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },

      "routes": [
        {
          "id": "a4cd522e",
          "key": "custom",
          "name": "新建报价",
          "method": "POST",
          "path": "/quotes",
          "auth": false,
          "summary": "按面积/数量/双面/制版费算价",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $ins = EXEC INSERT INTO {{t:main}} (job_name, paper, width, height, qty, sides, unit_price, plate_fee, total) VALUES ({{body.job_name}}, {{body.paper}}, {{body.width}}, {{body.height}}, {{body.qty}}, {{body.sides}}, {{body.unit_price}}, {{body.plate_fee}}, ROUND({{body.width}} * {{body.height}} / 10000 * {{body.qty}} * {{body.sides}} * {{body.unit_price}} + {{body.plate_fee}}, 2));\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "按面积/数量/双面/制版费算价",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "91abec38",
          "key": "custom",
          "name": "添加工艺",
          "method": "POST",
          "path": "/quotes/:id/processes",
          "auth": false,
          "summary": "后道工艺累加",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC INSERT INTO {{t:proc}} (quote_id, name, fee) VALUES ({{id}}, {{body.name}}, {{body.fee}});\nEXEC UPDATE {{t:main}} SET process_fee = process_fee + {{body.fee}}, total = total + {{body.fee}} WHERE id = {{id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "后道工艺累加",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "6811665f",
          "key": "custom",
          "name": "报价列表",
          "method": "GET",
          "path": "/quotes",
          "auth": false,
          "summary": "印刷报价列表",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT id, job_name, paper, qty, total, status FROM {{t:main}} ORDER BY id DESC;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "印刷报价列表",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "32f57eed",
          "key": "custom",
          "name": "报价详情",
          "method": "GET",
          "path": "/quotes/:id",
          "auth": false,
          "summary": "报价 + 后道工艺联查",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $q = QUERY SELECT * FROM {{t:main}} WHERE id = {{id}} LIMIT 1;\nLET $p = QUERY SELECT * FROM {{t:proc}} WHERE quote_id = {{id}};\nRETURN 200 { \"quote\": $q.rows, \"processes\": $p.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "报价 + 后道工艺联查",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "ff63fad0",
          "key": "custom",
          "name": "确认报价",
          "method": "PUT",
          "path": "/quotes/:id/submit",
          "auth": false,
          "summary": "业务员提交报价",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:main}} SET status = 'quoted' WHERE id = {{id}};\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "业务员提交报价",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "602ad377",
          "key": "custom",
          "name": "成交",
          "method": "PUT",
          "path": "/quotes/:id/approve",
          "auth": false,
          "summary": "客户确认成交",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:main}} SET status = 'approved' WHERE id = {{id}} AND status = 'quoted';\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,

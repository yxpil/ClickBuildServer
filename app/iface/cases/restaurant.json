          "script": "LET $t = QUERY SELECT id FROM {{t:main}} WHERE table_id = {{body.table_id}} AND status = 'open' LIMIT 1;\nLET $oid = 0;\nIF LEN($t.rows) > 0\n  SET $oid = $t.rows[0].id;\nELSE\n  LET $ins = EXEC INSERT INTO {{t:main}} (table_id, user_only_id, total) VALUES ({{body.table_id}}, {{user.onlyId}}, 0);\n  SET $oid = $ins.insertId;\nEND\nEXEC INSERT INTO {{t:item}} (order_id, dish_id, name, price, qty) VALUES ({{vars.oid}}, {{body.dish_id}}, {{body.name}}, {{body.price}}, {{body.qty}});\nEXEC UPDATE {{t:main}} SET total = COALESCE(total, 0) + {{body.price}} * {{body.qty}} WHERE id = {{vars.oid}};\nEXEC UPDATE {{t:dish}} SET stock = stock - {{body.qty}} WHERE id = {{body.dish_id}} AND stock >= {{body.qty}};\nRETURN 201 { \"ok\": true, \"orderId\": $oid };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },

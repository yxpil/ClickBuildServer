              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:main}} SET status = 'approved' WHERE id = {{id}} AND status = 'submitted';\nRETURN 200 { \"ok\": true };",
          "cache": {

      "routes": [
        {
          "id": "a4cd522e",
          "key": "custom",
          "name": "新建报价",
          "method": "POST",
          "path": "/quotes",
          "auth": false,
          "summary": "按面积和单价建立报价",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $ins = EXEC INSERT INTO {{t:main}} (customer_id, title, area, labor_rate, material_rate, discount, total) VALUES ({{body.customer_id}}, {{body.title}}, {{body.area}}, {{body.labor_rate}}, {{body.material_rate}}, {{body.discount}}, {{body.area}} * ({{body.labor_rate}} + {{body.material_rate}}));\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "按面积和单价建立报价",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "dc4a41aa",
          "key": "custom",
          "name": "添加项目",
          "method": "POST",
          "path": "/quotes/:id/items",
          "auth": false,
          "summary": "加项目并累计总额",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC INSERT INTO {{t:item}} (quote_id, name, spec, unit, qty, unit_price, amount) VALUES ({{id}}, {{body.name}}, {{body.spec}}, {{body.unit}}, {{body.qty}}, {{body.unit_price}}, {{body.qty}} * {{body.unit_price}});\nEXEC UPDATE {{t:main}} SET total = total + {{body.qty}} * {{body.unit_price}} WHERE id = {{id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "加项目并累计总额",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "9496adda",
          "key": "custom",
          "name": "折扣提交",
          "method": "PUT",
          "path": "/quotes/:id/submit",
          "auth": false,
          "summary": "按折扣率结价并提交",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:main}} SET total = ROUND(total * (1 - discount / 100), 2), status = 'submitted' WHERE id = {{id}};\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "按折扣率结价并提交",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "32f57eed",
          "key": "custom",
          "name": "报价详情",
          "method": "GET",
          "path": "/quotes/:id",
          "auth": false,
          "summary": "报价 + 明细 + 客户三表联查",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $q = QUERY SELECT * FROM {{t:main}} WHERE id = {{id}} LIMIT 1;\nLET $i = QUERY SELECT * FROM {{t:item}} WHERE quote_id = {{id}} ORDER BY id;\nLET $c = QUERY SELECT * FROM {{t:cust}} WHERE id = (SELECT customer_id FROM {{t:main}} WHERE id = {{id}}) LIMIT 1;\nRETURN 200 { \"quote\": $q.rows, \"items\": $i.rows, \"customer\": $c.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "报价 + 明细 + 客户三表联查",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "6811665f",
          "key": "custom",
          "name": "报价列表",
          "method": "GET",
          "path": "/quotes",
          "auth": false,
          "summary": "报价列表联查客户",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT q.id, q.title, q.area, q.total, q.status, c.name AS customer FROM {{t:main}} q LEFT JOIN {{t:cust}} c ON c.id = q.customer_id ORDER BY q.id DESC;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "报价列表联查客户",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "cd30e245",

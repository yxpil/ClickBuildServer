        {
          "id": "804dca53",
          "key": "custom",
          "name": "报名",
          "method": "POST",
          "path": "/courses/:id/enroll",
          "auth": true,
          "summary": "报名（防重复/防超员）",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $e = QUERY SELECT id FROM {{t:main}} WHERE course_id = {{id}} AND user_only_id = {{user.onlyId}} LIMIT 1;\nIF LEN($e.rows) > 0\n  RETURN 409 { \"ok\": false, \"error\": \"ALREADY_ENROLLED\" };\nEND\nLET $c = QUERY SELECT seats, enrolled FROM {{t:course}} WHERE id = {{id}} LIMIT 1;\nIF LEN($c.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_COURSE\" };\nEND\nIF $c.rows[0].enrolled >= $c.rows[0].seats\n  RETURN 409 { \"ok\": false, \"error\": \"FULL\" };\nEND\nEXEC INSERT INTO {{t:main}} (course_id, user_only_id) VALUES ({{id}}, {{user.onlyId}});\nEXEC UPDATE {{t:course}} SET enrolled = enrolled + 1 WHERE id = {{id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "报名（防重复/防超员）",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }

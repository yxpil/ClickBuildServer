        {
          "id": "32f57eed",
          "key": "custom",
          "name": "报价详情",
          "method": "GET",
          "path": "/quotes/:id",
          "auth": false,
          "summary": "报价 + 线路",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $q = QUERY SELECT * FROM {{t:main}} WHERE id = {{id}} LIMIT 1;\nLET $r = QUERY SELECT * FROM {{t:route}} WHERE id = (SELECT route_id FROM {{t:main}} WHERE id = {{id}}) LIMIT 1;\nRETURN 200 { \"quote\": $q.rows, \"route\": $r.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "报价 + 线路",
            "description": "",
            "requestExample": "",
            "responseExample": ""

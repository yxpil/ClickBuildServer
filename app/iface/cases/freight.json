        {
          "id": "ba178f91",
          "key": "custom",
          "name": "创建报价",
          "method": "POST",
          "path": "/quotes",
          "auth": false,
          "summary": "体积重/实重取大自动计费",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $ins = EXEC INSERT INTO {{t:main}} (customer_name, phone, route_id, weight, volume, chargeable, total) SELECT {{body.customer_name}}, {{body.phone}}, id, {{body.weight}}, {{body.volume}}, GREATEST({{body.weight}}, {{body.volume}} * volume_ratio), base_price + GREATEST({{body.weight}}, {{body.volume}} * volume_ratio) * price_per_kg FROM {{t:route}} WHERE id = {{body.route_id}} AND active = 1;\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "体积重/实重取大自动计费",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "6811665f",
          "key": "custom",
          "name": "报价列表",
          "method": "GET",
          "path": "/quotes",
          "auth": false,
          "summary": "报价联查线路",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT q.id, q.customer_name, q.chargeable, q.total, q.status, r.origin, r.destination FROM {{t:main}} q JOIN {{t:route}} r ON r.id = q.route_id ORDER BY q.id DESC;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60

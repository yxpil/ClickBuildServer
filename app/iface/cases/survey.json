        {
          "id": "cbd81f1d",
          "key": "custom",
          "name": "管理员登录",
          "method": "POST",
          "path": "/admin/login",
          "auth": false,
          "summary": "首次登录自动创建默认管理员",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $u = QUERY SELECT username, password, display_name FROM {{t:auth}} WHERE username = {{body.username}} LIMIT 1;\nIF LEN($u.rows) == 0\n  IF {{body.username}} == \"admin\" && {{body.password}} == \"Admin@123456\"\n    EXEC INSERT INTO {{t:auth}} (username, password, display_name, created_at) VALUES (\"admin\", SM4_ENC(\"Admin@123456\", \"clickbuild-key\"), \"管理员\", NOW());\n    LET $t0 = TOKEN NEW { \"username\": \"admin\", \"role\": \"admin\" };\n    RETURN 200 { \"ok\": true, \"token\": $t0.token, \"name\": \"管理员\" };\n  END\n  RETURN 401 { \"error\": \"BAD_LOGIN\", \"message\": \"账号或密码错误\" };\nEND\nIF SM4_DEC($u.rows[0].password, \"clickbuild-key\") != {{body.password}}\n  RETURN 401 { \"error\": \"BAD_LOGIN\", \"message\": \"账号或密码错误\" };\nEND\nLET $t = TOKEN NEW { \"username\": $u.rows[0].username, \"role\": \"admin\" };\nRETURN 200 { \"ok\": true, \"token\": $t.token, \"name\": $u.rows[0].display_name };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "首次登录自动创建默认管理员",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }

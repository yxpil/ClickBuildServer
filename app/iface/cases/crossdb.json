      "routes": [
        {
          "id": "0e6183b1",
          "key": "custom",
          "name": "跨库下单",
          "method": "POST",
          "path": "/orders",
          "auth": false,
          "summary": "主库写订单、辅库写明细，任一失败两边都回滚",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": true,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": true,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $o = EXEC INSERT INTO {{t:main}} (order_no, user_id, amount, status) VALUES ({{body.order_no}}, {{body.user_id}}, {{body.amount}}, 0);\nEXEC INSERT INTO {{schema:item}}{{t:item}} (order_id, sku, qty, price) VALUES ($o.insertId, {{body.sku}}, {{body.qty}}, {{body.price}});\nRETURN 201 { \"ok\": true, \"orderId\": $o.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "主库写订单、辅库写明细，任一失败两边都回滚",
            "description": "两张表在两个库（clickbuild / clickbuild_aux），由两个连接各自开事务；脚本成功才一起提交，异常一起回滚。",
            "requestExample": "{\n  \"order_no\": \"SO-001\",\n  \"user_id\": 1,\n  \"amount\": 99.5,\n  \"sku\": \"SKU-1\",\n  \"qty\": 2,\n  \"price\": 49.75\n}",
            "responseExample": "{\n  \"ok\": true,\n  \"orderId\": 1\n}"
          }
        },
        {
          "id": "75fcdd37",
          "key": "custom",
          "name": "故意失败（验证回滚）",
          "method": "POST",
          "path": "/orders/fail",
          "auth": false,
          "summary": "写完两边后制造错误，验证跨库回滚与 FATAL 日志",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC INSERT INTO {{t:main}} (order_no, user_id, amount, status) VALUES ({{body.order_no}}, {{body.user_id}}, {{body.amount}}, 0);\nEXEC INSERT INTO {{schema:item}}{{t:item}} (order_id, sku, qty, price) VALUES (0, {{body.sku}}, {{body.qty}}, {{body.price}});\nEXEC INSERT INTO {{schema:item}}{{t:item}} (no_such_column) VALUES (1);",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "写完两边后制造错误，验证跨库回滚与 FATAL 日志",
            "description": "最后一句写不存在的列，触发异常；正确行为是两个库都查不到这条订单。",
            "requestExample": "{\n  \"order_no\": \"SO-BAD\",\n  \"user_id\": 1,\n  \"amount\": 1,\n  \"sku\": \"X\",\n  \"qty\": 1,\n  \"price\": 1\n}",
            "responseExample": "{\n  \"ok\": false,\n  \"error\": \"UNKNOWN_COLUMN\"\n}"
          }
        },
        {
          "id": "6e6edf2c",
          "key": "custom",
          "name": "跨库订单列表",
          "method": "GET",
          "path": "/orders",
          "auth": false,
          "summary": "主库订单 LEFT JOIN 辅库明细",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT o.id, o.order_no, o.amount, o.status, COUNT(i.id) AS item_count FROM {{t:main}} o LEFT JOIN {{schema:item}}{{t:item}} i ON i.order_id = o.id GROUP BY o.id ORDER BY o.id DESC LIMIT 50;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "主库订单 LEFT JOIN 辅库明细",
            "description": "同实例跨库 JOIN；不同实例请拆成两次 QUERY，再用 HTTP/Redis 串。",

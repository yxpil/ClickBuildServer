          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $t = QUERY SELECT id, status FROM {{t:main}} WHERE {{idColumn:main}} = {{id}} LIMIT 1;\nIF LEN($t.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_TICKET\" };\nEND\nEXEC UPDATE {{t:main}} SET assignee = {{body.assignee}}, status = 1 WHERE {{idColumn:main}} = {{id}};\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "指定处理人并转处理中",
            "description": "指派必须带 assignee；会把 status 从 0 推到 1。",
            "requestExample": "",
            "responseExample": ""

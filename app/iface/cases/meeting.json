        {
          "id": "715dddf2",
          "key": "custom",
          "name": "创建会议",
          "method": "POST",
          "path": "/rooms",
          "auth": true,
          "summary": "创建会议室",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $ins = EXEC INSERT INTO {{t:room}} (room_no, title, host_only_id, start_at, end_at) VALUES ({{body.room_no}}, {{body.title}}, {{user.onlyId}}, {{body.start_at}}, {{body.end_at}});\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",
          "cache": {
            "enabled": false,

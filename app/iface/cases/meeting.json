          }
        },
        {
          "id": "553c781d",
          "key": "custom",
          "name": "会议列表",
          "method": "GET",
          "path": "/rooms",
          "auth": false,
          "summary": "进行中和历史会议",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT r.id, r.room_no, r.title, r.status, r.start_at, COUNT(p.id) AS people FROM {{t:room}} r LEFT JOIN {{t:part}} p ON p.room_id = r.id GROUP BY r.id ORDER BY r.id DESC;\nRETURN 200 { \"rows\": $rows.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "进行中和历史会议",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "b0e2ff1d",
          "key": "custom",
          "name": "加入会议",
          "method": "POST",
          "path": "/rooms/:id/join",
          "auth": true,
          "summary": "加入会议",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $r = QUERY SELECT status FROM {{t:room}} WHERE id = {{id}} LIMIT 1;\nIF LEN($r.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_ROOM\" };\nEND\nIF $r.rows[0].status != 1\n  RETURN 409 { \"ok\": false, \"error\": \"ROOM_CLOSED\" };\nEND\nEXEC INSERT INTO {{t:part}} (room_id, user_only_id) VALUES ({{id}}, {{user.onlyId}});\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "加入会议",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "386e70e3",
          "key": "custom",
          "name": "离开会议",
          "method": "PUT",
          "path": "/rooms/:id/leave",
          "auth": true,
          "summary": "离开会议",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:part}} SET left_at = NOW() WHERE room_id = {{id}} AND user_only_id = {{user.onlyId}} AND left_at IS NULL;\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "离开会议",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "77cbcd3a",
          "key": "custom",
          "name": "结束会议",
          "method": "PUT",
          "path": "/rooms/:id/end",
          "auth": true,
          "summary": "主持人结束会议并写纪要",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:room}} SET status = 0, end_at = NOW() WHERE id = {{id}} AND host_only_id = {{user.onlyId}};\nEXEC INSERT INTO {{t:min}} (room_id, summary) VALUES ({{id}}, {{body.summary}});\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "主持人结束会议并写纪要",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        }

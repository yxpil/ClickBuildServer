        {
          "id": "26dd9926",
          "key": "custom",
          "name": "添加模块",
          "method": "POST",
          "path": "/projects/:id/modules",
          "auth": false,
          "summary": "模块工作量自动计价并汇总",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $p = QUERY SELECT rate_per_day FROM {{t:main}} WHERE id = {{id}} LIMIT 1;\nIF LEN($p.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_PROJECT\" };\nEND\nEXEC INSERT INTO {{t:mod}} (project_id, name, days, amount) VALUES ({{id}}, {{body.name}}, {{body.days}}, {{body.days}} * {{vars.p.rows.0.rate_per_day}});\nEXEC UPDATE {{t:main}} SET total = total + {{body.days}} * {{vars.p.rows.0.rate_per_day}} WHERE id = {{id}};\nRETURN 201 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "模块工作量自动计价并汇总",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "4d6f7578",
          "key": "custom",
          "name": "折扣提交",
          "method": "PUT",
          "path": "/projects/:id/submit",
          "auth": false,
          "summary": "按折扣率生成报价",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "EXEC UPDATE {{t:main}} SET total = ROUND(total * (1 - discount / 100), 2), status = 'quoted' WHERE id = {{id}};\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "按折扣率生成报价",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "ba586555",
          "key": "custom",
          "name": "项目详情",
          "method": "GET",
          "path": "/projects/:id",
          "auth": false,
          "summary": "项目 + 模块 + 客户联查",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $p = QUERY SELECT * FROM {{t:main}} WHERE id = {{id}} LIMIT 1;\nLET $m = QUERY SELECT * FROM {{t:mod}} WHERE project_id = {{id}} ORDER BY id;\nLET $c = QUERY SELECT * FROM {{t:client}} WHERE id = (SELECT client_id FROM {{t:main}} WHERE id = {{id}}) LIMIT 1;\nRETURN 200 { \"project\": $p.rows, \"modules\": $m.rows, \"client\": $c.rows };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "项目 + 模块 + 客户联查",
            "description": "",
            "requestExample": "",
            "responseExample": ""
          }
        },
        {
          "id": "cbc460b9",
          "key": "custom",
          "name": "项目列表",

        {
          "id": "689971c6",
          "key": "custom",
          "name": "新建项目",
          "method": "POST",
          "path": "/projects",
          "auth": false,
          "summary": "按人天单价立项",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,

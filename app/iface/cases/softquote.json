              "cooldown": 30
            }
          },
          "script": "LET $rows = QUERY SELECT p.id, p.name, p.total, p.status, c.name AS client FROM {{t:main}} p LEFT JOIN {{t:client}} c ON c.id = p.client_id ORDER BY p.id DESC;\nRETURN 200 { \"rows\": $rows.rows };",

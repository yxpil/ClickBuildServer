              "cooldown": 30
            }
          },
          "script": "LET $ins = EXEC INSERT INTO {{t:main}} (client_id, name, requirement, rate_per_day, discount, total) VALUES ({{body.client_id}}, {{body.name}}, {{body.requirement}}, {{body.rate_per_day}}, {{body.discount}}, 0);\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",

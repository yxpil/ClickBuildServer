        {
          "id": "c50258f7",
          "key": "custom",
          "name": "预约",
          "method": "POST",
          "path": "/bookings",
          "auth": false,
          "summary": "先查容量，占位后写预约；满员 409",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $s = QUERY SELECT capacity, booked FROM {{t:slot}} WHERE {{idColumn:slot}} = {{body.slot_id}} LIMIT 1;\nIF LEN($s.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_SLOT\" };\nEND\nIF $s.rows[0].booked >= $s.rows[0].capacity\n  RETURN 409 { \"ok\": false, \"error\": \"FULL\" };\nEND\nEXEC UPDATE {{t:slot}} SET booked = booked + 1 WHERE {{idColumn:slot}} = {{body.slot_id}} AND booked < capacity;\nLET $ins = EXEC INSERT INTO {{t:main}} (service_id, slot_id, customer, phone) VALUES ({{body.service_id}}, {{body.slot_id}}, {{body.customer}}, {{body.phone}});\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "先查容量，占位后写预约；满员 409",

        {
          "id": "a0c3a433",
          "key": "custom",
          "name": "注册",
          "method": "POST",
          "path": "/register",
          "auth": false,
          "summary": "查重后插入，密码 SM4 加密，返回 onlyId 与 token",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $exists = QUERY SELECT id FROM {{t:main}} WHERE username = {{body.username}} LIMIT 1;\nIF LEN($exists.rows) > 0\n  RETURN 409 { \"ok\": false, \"error\": \"USER_EXISTS\" };\nEND\nEXEC INSERT INTO {{t:main}} (only_id, username, password_hash, nickname, phone) VALUES ({{onlyId}}, {{body.username}}, SM4_ENC({{body.password}}, 'clickbuild-key'), {{body.nickname}}, {{body.phone}});\nLET $t = TOKEN NEW { \"onlyId\": {{onlyId}}, \"username\": {{body.username}}, \"role\": \"user\" };\nRETURN 201 { \"ok\": true, \"onlyId\": {{onlyId}}, \"token\": $t.token };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "查重后插入，密码 SM4 加密，返回 onlyId 与 token",
            "description": "用户名唯一；密码先 SM4_ENC 再入库；注册成功直接签发 token。",
            "requestExample": "{\n  \"username\": \"alice\",\n  \"password\": \"123456\",\n  \"nickname\": \"Alice\",\n  \"phone\": \"13800000000\"\n}",
            "responseExample": "{\n  \"ok\": true,\n  \"onlyId\": \"OL...\",\n  \"token\": \"...\"\n}"
          }
        },
        {
          "id": "05447632",
          "key": "custom",
          "name": "登录",
          "method": "POST",
          "path": "/login",
          "auth": false,
          "summary": "账号密码登录，SM4 解密校验",
          "guard": {
            "tx": false,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $u = QUERY SELECT only_id, password_hash, role FROM {{t:main}} WHERE username = {{body.username}} LIMIT 1;\nIF LEN($u.rows) == 0\n  RETURN 401 { \"ok\": false, \"error\": \"NO_USER\" };\nEND\nIF SM4_DEC($u.rows[0].password_hash, 'clickbuild-key') != {{body.password}}\n  RETURN 401 { \"ok\": false, \"error\": \"BAD_PASSWORD\" };\nEND\nLET $t = TOKEN NEW { \"onlyId\": $u.rows[0].only_id, \"username\": {{body.username}}, \"role\": $u.rows[0].role };\nRETURN 200 { \"ok\": true, \"token\": $t.token };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "账号密码登录，SM4 解密校验",
            "description": "先按用户名取一行，再 SM4_DEC 比对；失败分别返回 NO_USER / BAD_PASSWORD。",
            "requestExample": "{\n  \"username\": \"alice\",\n  \"password\": \"123456\"\n}",
            "responseExample": "{\n  \"ok\": true,\n  \"token\": \"...\"\n}"
          }
        },

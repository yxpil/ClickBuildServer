          "script": "LET $ins = EXEC INSERT INTO {{t:main}} (order_no, user_only_id, receiver, address, amount) VALUES ({{body.order_no}}, {{onlyId}}, {{body.receiver}}, {{body.address}}, {{body.amount}});\nLET $oid = QUERY SELECT LAST_INSERT_ID() AS id;\nFOREACH $i IN {{body.items}}\n  EXEC INSERT INTO {{t:item}} (order_id, product_id, title, qty, price) VALUES ({{vars.oid.rows.0.id}}, $i.product_id, $i.title, $i.qty, $i.price);\nEND\nRETURN 201 { \"ok\": true, \"id\": $ins.insertId };",

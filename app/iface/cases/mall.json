        {
          "id": "a8a8e0c4",
          "key": "custom",
          "name": "扣库存（防超卖）",
          "method": "POST",
          "path": "/products/:id/stock",
          "auth": false,
          "summary": "库存不足直接 409，更新在事务里",
          "guard": {
            "tx": true,
            "rate": {
              "enabled": false,
              "limit": 60,
              "window": 60
            },
            "schedule": {
              "enabled": false,
              "from": "",
              "to": ""
            },
            "breaker": {
              "enabled": false,
              "threshold": 5,
              "cooldown": 30
            }
          },
          "script": "LET $p = QUERY SELECT stock FROM {{t:main}} WHERE {{idColumn:main}} = {{id}} LIMIT 1;\nIF LEN($p.rows) == 0\n  RETURN 404 { \"ok\": false, \"error\": \"NO_PRODUCT\" };\nEND\nIF $p.rows[0].stock < {{body.qty}}\n  RETURN 409 { \"ok\": false, \"error\": \"OUT_OF_STOCK\", \"stock\": $p.rows[0].stock };\nEND\nEXEC UPDATE {{t:main}} SET stock = stock - {{body.qty}}, sales = sales + {{body.qty}} WHERE {{idColumn:main}} = {{id}} AND stock >= {{body.qty}};\nRETURN 200 { \"ok\": true };",
          "cache": {
            "enabled": false,
            "key": "",
            "ttl": 60
          },
          "docs": {
            "summary": "库存不足直接 409，更新在事务里",
            "description": "先查库存，够才 UPDATE；UPDATE 的 WHERE 再带一次 stock >= qty，避免并发超卖。",
            "requestExample": "{\n  \"qty\": 2\n}",
            "responseExample": "{\n  \"ok\": true,\n  \"stock\": 8\n}"
          }
        }

{
  "name": "click-build-server",
  "version": "1.1.82",
  "description": "以接口为最小单位的后端服务生成器：多库多表、脚本 SQL、事务、缓存、RBAC 与一键生成可运行服务；Electron 桌面端，内置前端工坊与 26 套模版",
  "main": "main.js",
  "author": "yxpil",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i renderer/wbench.src.css -o renderer/wbench.css --minify",
    "test:templates": "node tools/test-templates.js --gen",
    "test:ci": "node tools/test-ci.js",
    "test:table-import": "node tools/test-table-import.js",
    "test:formtable": "node tools/test-formtable.js",
    "test:guide-templates": "node tools/test-guide-templates.js",
    "test:rbac-live": "node tools/test-rbac-live.js",
    "test:kits": "node tools/test-kits.js",
    "test:help": "node tools/test-help.js",
    "test:pack": "node tools/test-pack.js",
    "test:deploy": "node tools/test-deploy.js",
    "test:history": "node tools/test-history.js",
    "test:task-types": "node tools/test-task-types.js",
    "test:plugins": "node tools/test-plugins-v2.js",
    "test:docs": "node tools/test-docs.js",
    "test:types": "node tools/test-field-types.js",
    "test:export": "node tools/test-export-runtimes.js",
    "test:ui": "node tools/ui-smoke.js",
    "test:yxpp:preview": "node tools/test-yxpp-preview.js",
    "test:e2e": "node tools/e2e.js http://127.0.0.1:18100",
    "test:e2e:crossdb": "node tools/e2e-crossdb.js http://127.0.0.1:18300",
    "vendor:services": "node tools/vendor-services.js",
    "vendor:services:linux": "bash tools/vendor-services-linux.sh",
    "check:services": "node tools/check-services.js",
    "smoke:linux": "bash tools/linux-smoke.sh",
    "test:services:linux": "node tools/test-services-linux.js",
    "dist": "node tools/check-services.js && electron-builder --win nsis",
    "dist:dir": "node tools/check-services.js && electron-builder --win --dir",
    "dist:linux": "node tools/check-services.js && electron-builder --linux",
    "dist:linux:dir": "node tools/check-services.js && electron-builder --linux --dir",
    "test:ai": "node tools/test-ai.js",
    "test:ai:ollama": "node tools/test-ai-ollama.js",
    "test:export:single": "node tools/test-export-single-runtime.js",
    "test:ports": "node tools/test-port-fallback.js",
    "test:kernel": "node tools/test-kernel.js",
    "test:kernel:mysql": "node tools/test-kernel-mysql.js",
    "test:kernel:sqlgen": "node tools/test-kernel-sqlgen.js",
    "test:kernel:sqlgen:mysql": "node tools/test-kernel-sqlgen-mysql.js",
    "test:rust": "node tools/test-rust-render.js",
    "test:rust:runtime": "node tools/test-rust-runtime.js",
    "test:resources": "electron tools/test-resources.js",
    "test:testgen": "node tools/test-testgen.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "alasql": "^4.23.1",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "mysql2": "^3.24.6"
  },
  "build": {
    "appId": "com.yxpil.clickbuildserver",
    "productName": "ClickBuildServer",
    "copyright": "Copyright © 2026 yxpil",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "renderer/**/*",
      "assets/**/*",
      "plugins/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "logo.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ClickBuildServer-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "vendor/services",
          "to": "services"
        },
        {
          "from": "runtime/node",
          "to": "runtime/node"
        }
      ],
      "fileAssociations": [
        {
          "ext": "yxpn",
          "name": "ClickBuild 接口工程包",
          "description": "ClickBuild 接口工程包",
          "icon": "build/icon.ico",
          "role": "Editor"
        },
        {
          "ext": "yxpp",
          "name": "ClickBuild 前端工程",
          "description": "ClickBuild 前端工程",
          "icon": "build/icon.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClickBuildServer",
      "installerLanguages": [
        "zh_CN",
        "zh_TW",
        "en_US",
        "ja_JP",
        "ko_KR",
        "fr_FR",
        "de_DE",
        "es_ES",
        "pt_BR",
        "it_IT",
        "ru_RU",
        "ar_SA",
        "nl_NL",
        "pl_PL",
        "tr_TR",
        "th_TH",
        "vi_VN",
        "cs_CZ",
        "sv_SE"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "clickbuildserver",
      "artifactName": "ClickBuildServer-${version}-${arch}.${ext}",
      "maintainer": "yxpil <yxpil@users.noreply.github.com>",
      "synopsis": "可视化接口生成与本地服务编排工具",
      "description": "ClickBuildServer 用可视化方式定义接口与数据表，生成 Node / Python / Go / Java / Rust 服务，并在本机编排 MariaDB、Redis、RustFS 与内置 Node 运行时。",
      "extraResources": [
        {
          "from": "vendor/services-linux",
          "to": "services"
        },
        {
          "from": "runtime/node-linux",
          "to": "runtime/node"
        }
      ],
      "fileAssociations": [
        {
          "ext": "yxpn",
          "name": "ClickBuild 接口工程包",
          "mimeType": "application/x-clickbuild-yxpn",
          "role": "Editor",
          "icon": "build/icon.png"
        },
        {
          "ext": "yxpp",
          "name": "ClickBuild 前端工程",
          "mimeType": "application/x-clickbuild-yxpp",
          "role": "Editor",
          "icon": "build/icon.png"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxrandr2",
        "libasound2 | libasound2t64",
        "libcups2 | libcups2t64"
      ]
    }
  }
}
